# Copy to ".env" in the project folder on the server and fill in the values. Never commit the real .env file.
# Write the values WITHOUT quotes.

# Your public address, no https:// and no www, for example: example.org
DOMAIN=example.org

# The browser address(es) that may use the contact form: both the bare and the www address.
ALLOWED_ORIGINS=https://example.org,https://www.example.org

# One reverse proxy (Caddy) sits in front of the site. Use 2 if you also switch on Cloudflare's orange-cloud proxy for this domain.
TRUST_PROXY_HOPS=1

# Contact form e-mail (Gmail with an App Password: Google Account > Security > 2-Step Verification > App passwords)
CONTACT_RECIPIENT_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-16-letter-app-password
SMTP_FROM=Portfolio Contact <you@example.com>
