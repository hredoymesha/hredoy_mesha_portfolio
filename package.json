    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts --production",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test:unit": "tsx --test src/components/LivingGlobe/astronomy/sunPosition.test.ts",
    "test:server": "tsx --test tests/server.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test:scan": "node tests/scan.mjs",
    "test:e2e": "node tests/e2e/site.mjs",
    "test:matrix": "node tests/e2e/matrix.mjs",
    "matrix:write": "node tests/e2e/matrix.mjs --write",
    "test:citecraft": "node tests/citecraft.mjs",
    "test:citecraft-ui": "node tests/e2e/citecraft.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:server && npm run build && npm run test:scan && npm run test:e2e && npm run test:matrix && npm run test:citecraft && npm run test:citecraft-ui",
    "verify": "npm test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
