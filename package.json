    "lucide-react": "^0.546.0",
    "nodemailer": "^10.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "axe-core": "4.10.2",
    "playwright": "1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
