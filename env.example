# Copy this file to .env for local development. Never commit the real .env file.

# --- Server ---
# Port the Express server listens on.
# PORT=3000
# Number of reverse proxies in front of the server (used to read the visitor IP safely).
# 0 = none (your own computer: this is the default in development), 1 = one proxy (most hosts; the default in production).
# If your host sits behind two layers (for example Cloudflare plus the host), use 2. Do not set to "true".
# TRUST_PROXY_HOPS=1
# Public address(es) of the site, comma-separated. Contact-form requests from other origins are refused.
# Leave empty to accept only same-origin requests.
ALLOWED_ORIGINS=http://localhost:3000

# HOST=0.0.0.0   # only to open the development site from a phone on your own network (default: this computer only)

# Folder for the contact-message log (IP address, message, time). Defaults to ./logs
# LOGS_DIR=./logs

# --- Contact form: e-mail delivery ---
CONTACT_RECIPIENT_EMAIL=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
# Use an application password, not your normal mail password.
# Write the values WITHOUT quotes (Docker and some hosts would keep the quote characters).
SMTP_PASS=your-app-password
SMTP_FROM=Portfolio Contact <you@example.com>
# Contact-form limits per visitor IP: maximum submissions per window (minutes).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=15

# --- CiteCraft (local citation API) ---
# Python executable and loopback port for the CiteCraft API started by the server.
# CITECRAFT_PYTHON=python3
# CITECRAFT_API_PORT=8765
